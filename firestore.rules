rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Each signed-in user can access only their own AJ KHATA BOOK ledger.
    match /users/{userId}/ledger/{documentId} {
      allow read, create, update, delete: if request.auth != null
        && request.auth.uid == userId;
    }

    // Deny all other documents unless a later rule explicitly allows them.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
